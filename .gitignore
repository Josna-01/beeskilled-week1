# ==============================================================================
# BeeSkilled - Week 1: Root .gitignore
# Comprehensive security, dependencies, and build artifact exclusions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sensitive Files, Credentials & Environment Configurations
# ------------------------------------------------------------------------------
# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.env.*

# Allow committed template/example configurations
!.env.example
!*.env.example

# Private cryptographic keys & certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.csr
*.cer

# SSH credentials
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pub

# Cloud & Service Account Credentials
*service-account*.json
*credentials*.json
client_secret*.json
firebase-adminsdk*.json
aws-credentials*
.aws/

# ------------------------------------------------------------------------------
# 2. Package Dependencies & Package Manager Caches
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# ------------------------------------------------------------------------------
# 3. Build & Compiler Artifacts
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.nuxt/
.vuepress/dist/

# Test coverage & analysis reports
coverage/
**/coverage/
*.lcov
.nyc_output/

# Tooling and compilation caches
.vite/
**/.vite/
.cache/
**/.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
ts-node/

# Logs & debugging traces
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 5. IDE, Editors & Development Environment Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.backup
*.old
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 6. Local Databases & Debug Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.seed
